# Newman settings. Copy to .env. Almost everything else is set up in the dashboard.

# Required: signs notification links. Generate with: openssl rand -hex 32
TOKEN_SECRET=

# Your time zone (schedules and times use it)
TZ=America/Toronto

# The address phones use to reach Newman (links inside notifications)
PUBLIC_URL=https://home.example.com
# Optional: a separate no-mTLS host for token-only links (/api/public/*)
# PUBLIC_TOKEN_URL=https://homelinks.example.com

# Push notifications (iOS: APNs .p8 key; Android: Firebase service account) - paths set in docker-compose.yml
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=ca.nimaste.newman

# Apple Maps for the web and wall maps (MapKit JS). Unset = OpenFreeMap (no key needed).
# The key's id; the team defaults to APNS_TEAM_ID. The key file defaults to the APNs key file when this
# is the APNs key's id (one key with both services), else /app/keys/mapkit.p8 - or set MAPKIT_KEY_PATH.
# MAPKIT_KEY_ID=
# MAPKIT_TEAM_ID=
# MAPKIT_KEY_PATH=/app/keys/mapkit.p8

# First-boot MQTT broker (after that: Connections → MQTT devices)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Voice on the wall tablets (README → Voice): the Wyoming speech containers (docker compose --profile voice)
# VOICE_STT=127.0.0.1:10300
# VOICE_TTS=127.0.0.1:10200
# VOICE_NAME=en_US-lessac-medium
# Or the Kokoro voice (newman-kokoro), with Piper above as its fallback:
# VOICE_TTS_KIND=openai
# VOICE_TTS_URL=http://127.0.0.1:8880
# VOICE_NAME=af_heart
