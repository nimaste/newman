<?xml version="1.0" encoding="utf-8"?>
<!--
  Plain http is allowed here so a hub's home-network address works whatever it is (http://192.168.1.20:8093,
  http://10.0.0.5:8093 - Android can't express IP ranges in this file). The app itself refuses plain http
  to anything that isn't a home-network address (core/net/ServerAddress.kt and HubInterceptor), and the
  wall's WebView only ever loads the hub.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>