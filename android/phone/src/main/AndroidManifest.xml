<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Location sharing with the household (only when the person or the household turns it on).
         Background reports come as PendingIntent location updates: no foreground service. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Location updates are cleared by a reboot or an app update: start them again. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Scanning the hub's QR code (asked for only when scanning). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".NewmanApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Newman"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Newman">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- newman://connect?... - the hub's connect link (its QR code). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="newman" android:host="connect" />
            </intent-filter>
        </activity>

        <service
            android:name=".push.NewmanMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".push.ActionReceiver"
            android:exported="false" />
        <!-- Live statuses' plain buttons (push/LiveStatusNotifier.kt). -->
        <receiver
            android:name=".push.LiveActionReceiver"
            android:exported="false" />

        <!-- Location fixes (PendingIntent updates) and restarting them after a reboot / update. -->
        <receiver
            android:name=".location.LocationReceiver"
            android:exported="false" />
        <receiver
            android:name=".location.LocationRestartReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widget (widgets/DeviceGridWidget.kt): a grid of devices, chosen when it's added. -->
        <receiver
            android:name=".widgets.DeviceGridReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/device_grid_widget" />
        </receiver>
        <activity
            android:name=".widgets.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Newman">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".widgets.ConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Newman.Translucent" />

        <!-- Quick Settings tiles "Newman 1/2/3"; long-press one for TileSettingsActivity. -->
        <service
            android:name=".widgets.NewmanTile1"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="Newman 1"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service
            android:name=".widgets.NewmanTile2"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="Newman 2"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service
            android:name=".widgets.NewmanTile3"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="Newman 3"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <activity
            android:name=".widgets.TileSettingsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Newman">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Device Controls (Android 11+, widgets/NewmanControlsService.kt): the power menu / Quick Settings
             panel's switches and buttons for the devices a widget can show. -->
        <service
            android:name=".widgets.NewmanControlsService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CONTROLS">
            <intent-filter>
                <action android:name="android.service.controls.ControlsProviderService" />
            </intent-filter>
        </service>

        <!-- The app icon's shortcuts and "Add to home screen": run a device's tap without opening the app. -->
        <activity
            android:name=".widgets.ShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Newman.Invisible">
            <intent-filter>
                <action android:name="ca.nimaste.newman.RUN_DEVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Data-only messages pick their own channel; this is the fallback. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="alerts" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
    </application>
</manifest>
